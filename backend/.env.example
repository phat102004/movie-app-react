# TMDB > Settings > API > API Read Access Token
# Sao chép file này thành backend/.env và điền token của bạn.

TMDB_READ_ACCESS_TOKEN=your_tmdb_api_read_access_token

# Không dùng placeholder này như mật khẩu thật; không gửi URL thật vào chat/Git.
DATABASE_URL="postgresql://postgres:<PASSWORD>@localhost:5432/cineverse_dev?schema=public"
# Auth browser origins: explicit exact origins; no wildcard or trailing slash.
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: NODE_ENV=production and AUTH_ALLOWED_ORIGINS=https://cineverse.example
# Secure __Host- cookie is mandatory in production; HTTPS required.

# Password recovery: disabled until you explicitly configure email delivery.
PASSWORD_RESET_EMAIL_MODE=disabled
PUBLIC_APP_ORIGIN=http://localhost:5173
# Local Mailpit: mode=local, host=127.0.0.1, port=1025, secure=false, no auth.
# Production: mode=smtp, real SMTP host/credentials, HTTPS origin in AUTH_ALLOWED_ORIGINS.
# SMTP_SECURE=true for implicit TLS (usually 465); false requires STARTTLS in smtp mode.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=cineverse@localhost.test
SMTP_USER=
SMTP_PASSWORD=
