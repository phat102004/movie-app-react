# Dashboard reference ONLY: do not import until Phase 9C review and approval.
# No render.yaml: no resources or automatic deployment are created in Phase 9B.
NODE_VERSION=22.23.4
NODE_ENV=production
HOSTING_MODE=render
HOST=0.0.0.0
# PORT and RENDER are injected by Render. Do not copy local PORT=3001.

AUTH_ALLOWED_ORIGINS=https://your-service.onrender.com
PUBLIC_APP_ORIGIN=https://your-service.onrender.com
DATABASE_URL="postgresql://cineverse_app:<RUNTIME_PASSWORD>@<NEON_DIRECT_HOST>:5432/cineverse_prod?schema=public&sslmode=require&sslaccept=strict"
PRODUCTION_DATABASE_HOST=<NEON_DIRECT_HOST>
# Optional PUBLIC CA absolute path, not a private/client key; default public roots.
DATABASE_SSL_CA_FILE=
# Keep strict. An absolute, operator-reviewed evidence file is required for any
# neon-reviewed-system-connect opt-in; never an automatic Neon default.
DATABASE_SECURITY_POLICY=strict
DATABASE_PROVIDER_EVIDENCE_FILE=
# Managed V1 requires its own reviewed operator profile; keep strict until approved.
# See docs/phase-9c3c-managed-postgresql-contract-v1.md before changing this value.
# Keep socket-only until actual ingress CIDRs/overwrite policy have been verified.
TRUSTED_PROXY_CIDRS=
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token
TMDB_MAX_CONCURRENT=6
TMDB_MAX_QUEUE=32
PASSWORD_RESET_EMAIL_MODE=resend
SMTP_FROM=sender@your-verified-domain.example
RESEND_API_KEY=your_resend_sending_api_key
# NEVER add MIGRATION_DATABASE_URL, bootstrap/admin credentials or VITE_* secrets.
